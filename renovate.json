{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>dacrab/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Keep the go directive on the latest patch release so standard library security fixes are picked up",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "matchUpdateTypes": ["patch"],
      "rangeStrategy": "bump"
    }
  ],
  "postUpdateOptions": ["gomodTidy"]
}
